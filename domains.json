{
  "schemaVersion": 1,
  "domains": {
    "neuroimaging": {
      "source_repositories": ["NeuroDesk/neurocontainers"],
      "title": "neurodesk",
      "description": "Neuroimaging tools and resources for neuroimaging research and analysis.",
      "registry": "docker.io/vnmd/neurodesktop",
      "defaultVersion": "2026-09-23",
      "releaseHistoryUrl": "https://raw.githubusercontent.com/neurodesk/neurodesk.github.io/refs/heads/main/src/content/docs/overview/release-history/index.mdx",
      "containerName": "neurodesktop",
      "volumeMount": "neurodesk-home",
      "defaultStorageMount": "neurodesktop-storage",
      "remoteUrl": [
        "https://play.neurodesk.cloud.edu.au/",
        "https://play-america.neurodesk.org/",
        "https://play-europe.neurodesk.org/"
      ],
      "appJsonUrl": "https://apps-catalog.scigetorg.workers.dev/neuroimaging/apps.json",
      "downloadUrls": [
        "https://object-store.rc.nectar.org.au/v1/AUTH_dead991e1fa847e3afcca2d3a7041f5d/neurodesk/{file}",
        "https://neurocontainers.s3.us-east-2.amazonaws.com/{file}"
      ]
    },
    "microscopy": {
      "source_repositories": ["NeuroDesk/neurocontainers"],
      "title": "microscopy",
